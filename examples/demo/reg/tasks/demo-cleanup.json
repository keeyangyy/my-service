{
  "path": "{{WORKDIR}}/services",
  "display": "示例清理任务",
  "description": "每 5 分钟跑一次的示例任务（演示 interval 调度）",
  "mode": "task",
  "start": {
    "entry": "demo_task.py",
    "args": ["--note", "demo cleanup", "--log", "{{WORKDIR}}/data/demo-cleanup.log"]
  },
  "schedule": { "type": "interval", "every_sec": 300 },
  "settings": { "state": "active", "catch_up": false, "run_timeout_sec": 60 }
}
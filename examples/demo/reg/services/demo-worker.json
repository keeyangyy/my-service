{
  "path": "{{WORKDIR}}/services",
  "display": "示例常驻服务",
  "description": "常驻托管示例，健康探测走端口（33511），宿主启动时自动拉起",
  "mode": "managed",
  "start": {
    "entry": "demo_app.py",
    "args": ["--port", "33511", "--name", "示例常驻服务", "--color", "green", "--pidfile", "demo-worker.pid"]
  },
  "stop": { "script": "stop_demo.ps1" },
  "identity": {
    "port": 33511,
    "timeout_sec": 30,
    "pidfile": "demo-worker.pid"
  },
  "settings": { "state": "active", "autostart": true }
}
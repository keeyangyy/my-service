# 运行时数据（本项目约定：日志/账本/缓存/备份统一放 data/ 下）
#   data/logs/  记录：只追加、可随时删，删了不影响下次运行
#   data/bak/   备份、data/pids/ 运行态 pid、cron_state.json 等：删了行为会变
data/

# 临时 / 会话交接
tmp/
context/

# Python 产物
__pycache__/
*.pyc

# 测试产物
.coverage
coverage.xml
htmlcov/

# 打包产物与运行时缓存
dist/
tools/.cache/

# 原子写残留（注册条/账本写入中断留下的 *.json.tmp）
*.tmp

# 面板快捷方式：每台机器按本机 config.json 生成，不入库
run/Dashboard.url

# 隐私检查的私有名词清单（本机专用，不入库）
tools/privacy-deny.txt

# 实例配置（本地保留，不入库）
/reg/
/config.json